# ─────────────────────────────────────────────────────────────
# UNC Thoughts HQ — environment
# Copy this file to `.env` and adjust. Everything works WITHOUT a
# paid AI service. AI is strictly optional and off by default.
# ─────────────────────────────────────────────────────────────

# Database. SQLite locally; swap for a postgres:// URL to migrate to Postgres.
# (The schema is written provider-agnostically — see README "Moving to Postgres".)
DATABASE_URL="file:./dev.db"

# App
NODE_ENV="development"
APP_TIMEZONE="Australia/Sydney"
# Public base URL (used for absolute links in exports); safe default for local.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Feature flags ────────────────────────────────────────────
# Release B (adult 18+ community beta) is OFF by default. Turn on only after
# reading docs/COMMUNITY-SAFETY-CHECKLIST.md.
FEATURE_COMMUNITY_BETA="false"
# Optional local video inspection via ffmpeg (must be installed on PATH).
FEATURE_VIDEO_INSPECT="false"

# ── Optional AI (OFF by default) ─────────────────────────────
# If you set a provider + key, the app can SUGGEST replies/hooks. It will NEVER
# send or save generated content without your explicit approval. Cost is on you
# and billed by the provider — see README "Optional AI". Leaving these blank
# keeps the full rule-based system working.
AI_PROVIDER=""          # "" (none) | "anthropic" | "openai"
AI_API_KEY=""
AI_MODEL=""

# ── Auth (Release B) ─────────────────────────────────────────
# Secret used to sign session cookies for community accounts. Generate a long
# random string for production. Not needed while Release B is off.
AUTH_SECRET="change-me-in-production-a-long-random-string"
